# ==============================================================================
# JARVIS ALL-IN-ONE (WEB OS, TELEGRAM BOT & ANDROID APP) ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Bot Owner Telegram User ID (Numeric ID from @userinfobot)
BOT_OWNER_ID=your_telegram_user_id_here

# OpenRouter AI API Key (Supports Gemini 2.5 Flash, GPT-4o Mini, DeepSeek, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Cartesia Sonic Neural Voice API Key (Optional - Falls back to Edge TTS / Google)
CARTESIA_API_KEY=your_cartesia_api_key_here

# Microsoft Edge Neural TTS Voice (Default: hi-IN-MadhurNeural)
VOICE_NAME=hi-IN-MadhurNeural

# Activation Flag (Must be true)
ACTIVATE_TELEGRAM_WEBHOOK_REPLACEMENT=true

# Telegram Client Credentials for Voice Chat (VC) Streaming (my.telegram.org)
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# Assistant Pyrogram Session String (Generated via generate_session.py)
TELEGRAM_SESSION_STRING=your_pyrogram_session_string_here

# Web OS & Dashboard HTTP Port (Default: 3000)
WEB_PORT=3000
